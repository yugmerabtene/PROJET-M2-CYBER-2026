APP_NAME=DevinciWatch API
APP_ENV=dev
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/devinciwatch
REDIS_URL=redis://redis:6379/0

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

AGENT_INGEST_KEY=CHANGE_ME_AGENT_INGEST_KEY

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
