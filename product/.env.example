# DevinciWatch — variables d'environnement du lab Docker
# Copier ce fichier en .env et adapter les valeurs avant lancement

# Backend
SECRET_KEY=change-me-in-production-use-a-long-random-string
APP_ENV=dev
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comptes par défaut (à changer en production)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMeNow123!

# Agent
AGENT_INGEST_KEY=devinciwatch-agent-key-change-me
DEVINCIWATCH_AGENT_INGEST_KEY=devinciwatch-agent-key-change-me
DEVINCIWATCH_INTERVAL_SECONDS=10
