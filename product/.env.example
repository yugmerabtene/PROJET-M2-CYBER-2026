# DevinciWatch — variables d'environnement du lab Docker
# Copier ce fichier en .env et adapter les valeurs avant lancement

# Backend
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
APP_ENV=dev
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comptes par défaut (à changer en production)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Agent
AGENT_INGEST_KEY=CHANGE_ME_AGENT_INGEST_KEY
DEVINCIWATCH_AGENT_INGEST_KEY=CHANGE_ME_AGENT_INGEST_KEY
DEVINCIWATCH_INTERVAL_SECONDS=10
